#pragma once

// TOKEN de desenvolvimento para provisionamento simplificado
// Use um token forte para ambiente de produção
#define SECRET_DEV_TOKEN "SUA_CHAVE_DEV_AQUI"

// Credenciais de Bootstrap (Usadas apenas na primeira conexão)
#define SECRET_SETUP_MQTT_PASSWORD "SUA_SENHA_SETUP_AQUI"

// Senha do Access Point de configuração criado pelo ESP32
#define SECRET_WIFI_AP_PASSWORD "SUA_SENHA_AP_AQUI"
