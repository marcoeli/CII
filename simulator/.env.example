# Configurações do Broker MQTT (Bootstrap)
MQTT_HOST=mqtt.icodz.com.br
MQTT_PORT=1883
MQTT_SETUP_USER=setup
MQTT_SETUP_PASS=SUA_SENHA_BOOTSTRAP_AQUI

# Token de Desenvolvimento para Provisionamento
DEV_TOKEN=SEU_TOKEN_DEV_AQUI

# Nota: Este arquivo deve ser copiado para '.env' e não deve ser commitado.
